#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

typedef struct _Student {
	char ime[20];
	char prezime[30];
	int bodovi;
}stud;
int main()
{
	char buffer[50];
	int brojac = 0;
	FILE* fp = fopen("popis.txt", "r");
	if (fp == NULL) {
		printf("File nije uspjesno otvoren\n");
		return -1;
	}
	while (!feof(fp)) {
		fgets(buffer, 50, fp);
		brojac++;
	}
	stud* Studenti = NULL;
	Studenti = (stud*)malloc(sizeof(stud) * brojac);
		if (!Studenti) {
			printf("Greska pri alokaciji memorije");
			free(Studenti);
			return -2;
		}
	
		for (int i = 0; i < brojac; i++) {
			fscanf(fp, " %s %s %d", Studenti[i].ime, Studenti[i].prezime, &Studenti[i].bodovi);
			i++;
		}
	fclose(fp);
	free(Studenti);
	return 0;
}